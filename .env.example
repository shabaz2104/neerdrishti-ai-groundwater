NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only AI configuration. Development defaults to ollama; production to hosted.
# hosted uses OpenAI Responses over fixed HTTPS; openrouter uses its fixed HTTPS chat endpoint.
AI_PROVIDER=
AI_API_KEY=
AI_INTENT_MODEL=
# Optional: defaults to intent model.
AI_ANSWER_MODEL=
# OpenRouter settings are used only when AI_PROVIDER=openrouter. Never NEXT_PUBLIC.
# Models may be openrouter/free or an explicit OpenRouter model ID.
OPENROUTER_API_KEY=
OPENROUTER_INTENT_MODEL=
# Optional: defaults to the OpenRouter intent model.
OPENROUTER_ANSWER_MODEL=
# Milliseconds, 1000-120000. Hosted defaults: intent 10000 / answer 15000.
# Ollama defaults: 30000 each, unless legacy OLLAMA_TIMEOUT_MS is set.
AI_INTENT_TIMEOUT_MS=
AI_ANSWER_TIMEOUT_MS=
# Defaults: intent 256 (128-1024), answer 512 (128-2048).
AI_INTENT_MAX_TOKENS=
AI_ANSWER_MAX_TOKENS=
# Local defaults: http://localhost:11434 and gemma3:4b. Never NEXT_PUBLIC.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=
# Model residency: 1m-60m, default 10m; no background polling.
OLLAMA_KEEP_ALIVE=
